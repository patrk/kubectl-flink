# The look of the README recordings: a dark terminal in a window on a margin. MarginFill is GitHub's dark page
# colour; hack/demo-gifs.sh records each tape a second time on the light one.
Set FontFamily "MesloLGS NF"
Set FontSize 16
Set LineHeight 1.2
Set Width 1960
Set Padding 28
Set Margin 36
Set MarginFill "#0d1117"
Set WindowBar Colorful
Set WindowBarSize 40
Set BorderRadius 14
Set Theme "Catppuccin Mocha"
Set TypingSpeed 55ms
Set CursorBlink false
Set Framerate 30
